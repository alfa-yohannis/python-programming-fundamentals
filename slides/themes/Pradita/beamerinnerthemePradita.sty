% Title page. Box width keeps the text inside the white area, left of the photo at x = 10 cm.
\defbeamertemplate*{title page}{Pradita}[1][]
{ 
	\vskip2.6cm%
	\begin{beamercolorbox}[wd=8.6cm,#1]{subtitle page header}
		\usebeamerfont{subtitle}\insertsubtitle\par%
	\end{beamercolorbox}%
	\vskip0.3cm%
	\begin{beamercolorbox}[wd=8.6cm,#1]{title page header}
		\usebeamerfont{title}\Large\textbf{\inserttitle}\par%
	\end{beamercolorbox}%
	\vskip0.7cm%
	\begin{beamercolorbox}[wd=8.6cm,#1]{date}
		\usebeamerfont{author}\insertdate%
	\end{beamercolorbox}
	\vskip0.6cm%
	\begin{beamercolorbox}[wd=8.6cm,#1]{author}
		\usebeamerfont{author}\insertauthor%
	\end{beamercolorbox}
	\vfill
}

